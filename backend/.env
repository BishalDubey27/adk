# GCP Configuration
GOOGLE_CLOUD_PROJECT=tech-sarathi
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# AlloyDB Configuration (use localhost for local development)
ALLOYDB_HOST=localhost
ALLOYDB_DATABASE=sarathi
ALLOYDB_USER=postgres
ALLOYDB_PASSWORD=postgres
ALLOYDB_PORT=5432

# AI Configuration
GEMINI_MODEL=gemini-1.5-pro
GEMINI_API_KEY=your-gemini-api-key

# App Configuration
CONFIDENCE_AUTO_THRESHOLD=0.85
CONFIDENCE_ESCALATE_THRESHOLD=0.65
REACT_LOOP_INTERVAL_SECONDS=300

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment
ENVIRONMENT=development
